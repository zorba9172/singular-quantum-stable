// §λ("discoveries") §ω("17.0") §κ("⛨")
// DISC-000044 Formula — 3-Layer Relativistic Symplectic Particle Accelerator & Esirkepov PIC (⟁_ACC)
§λ("discoveries")
§ω("17.0")
§κ("⛨")

Ω ⟦ ω_0 : 𝕊[4096], Ψ_0 : ⛨ℝ[145, 64], W_0 : ℝ[64, 64], δ_0 : Δℝ[16], S_0 : ⛨ℝ[145, 64], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← ⟁_ACC(Ψ_0, δ_0)
  Ψ_2 ← ⟁_CIE(Ψ_1, δ_0)
  Ψ_3 ← φg(Ψ_0 ⋅ W_0)
  Ψ_4 ← ∇_g(Ψ_2) + ⛨(Ψ_1, S_0)
  Ψ_5 ← Ψ_3 ⊕ δ_0
  Ψ_0 ← Ψ_5 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_5)
  ⊢ Ψ_1 ≈ Ψ_0
  ⊢ d(d(ω_0)) ≈ 0.0
  ⊢ |Ψ_4| < ∞
}
