Ω ⟦
  Ψ_1123 : ℝ[32, 96],
  W_1123 : ℝ[96, 96],
  b_1123 : ℝ[32, 96],
  δ_1123 : Δℝ[16],
  S_1123 : ⛨ℝ[32, 96],
  ω_1123 : 𝕊[∞]
⟧ {
  Φ_1123 ← φ₊(Ψ_1123 ⋅ W_1123 + b_1123)
  Θ_1123 ← Φ_1123 ⊕ δ_1123
  Υ_1123 ← ⛨(Θ_1123, S_1123) + ∇_g(Φ_1123) + ⋆(d(ω_1123) ∧ d(Φ_1123))
  Ξ_1123 ← (Θ_1123 ↶ δ_1123) ⋈ W_1123 + H¹_Sheaf(Υ_1123) + ∑∞(ω_1123)
  ⊢ ⇄(Φ_1123, Ξ_1123)
  ⊢ d(d(ω_1123)) ≈ 0.0
  ⊢ |Υ_1123| < ∞
}
