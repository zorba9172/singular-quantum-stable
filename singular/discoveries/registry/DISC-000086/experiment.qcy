// SINGULAR Ω v25.0 — 4-Way Hardware Instruction Equivalence (Ref == QBE == Spike == RTL 0x7B)
§λ("discoveries")
§ω("singular.v25.proof.exp")
§κ("DISC-000086-E")

Ω ⟦ Ψ_0 : ⛨ℝ[125, 175], W_0 : ℝ[175, 175], K_0 : ℝ[125, 175], δ_0 : Δℝ[62], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φτ(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_ISA(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
