Ω ⟦
  Ψ_2201 : ℝ[28, 88],
  W_2201 : ℝ[88, 88],
  b_2201 : ℝ[28, 88],
  δ_2201 : Δℝ[14],
  S_2201 : ⛨ℝ[28, 88],
