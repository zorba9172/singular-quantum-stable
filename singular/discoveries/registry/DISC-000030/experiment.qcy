// SINGULAR Ω v14.0 — DISC-000030 Experiment
§λ("discoveries")
§ω("singular.v14.discovery")
§κ("DISC-000030-EXP")

Ω ⟦ Ψ_0 : ⛨ℝ[48, 79], W_0 : ℝ[79, 79], K_0 : ℝ[48, 79], δ_0 : Δℝ[10], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⊥_Σ(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
