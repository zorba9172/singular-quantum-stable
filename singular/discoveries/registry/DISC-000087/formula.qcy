// SINGULAR Ω v25.0 — Dual-Target FPGA LUT6 (414.9 MHz) vs ASIC Gate-Level Timing Closure & pJ/Op Model
§λ("discoveries")
§ω("singular.v25.proof")
§κ("DISC-000087-F")

Ω ⟦ Ψ_0 : ⛨ℝ[126, 176], W_0 : ℝ[176, 176], K_0 : ℝ[126, 176], δ_0 : Δℝ[63], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_RTL(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
