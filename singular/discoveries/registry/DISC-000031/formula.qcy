// SINGULAR Ω v14.0 — DISC-000031 Formula
§λ("discoveries")
§ω("singular.v14.discovery")
§κ("DISC-000031-FORMULA")

Ω ⟦ Ψ_0 : ⛨ℝ[50, 86], W_0 : ℝ[86, 86], K_0 : ℝ[50, 86], δ_0 : Δℝ[11], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⊕_trop(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
