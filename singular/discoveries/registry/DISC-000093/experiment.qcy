// SINGULAR Ω v25.0 — Harmonic Hodge-Helmholtz Singular Arc Decomposition (d0_phi + d1*_psi + H1)
§λ("discoveries")
§ω("singular.v25.sarc.siac.exp")
§κ("DISC-000093-E")

Ω ⟦ Ψ_0 : ⛨ℝ[137, 187], W_0 : ℝ[187, 187], K_0 : ℝ[137, 187], δ_0 : Δℝ[68], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φτ(Ψ_0 ⋅ W_0)
  Ψ_2 ← ◈_H(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
