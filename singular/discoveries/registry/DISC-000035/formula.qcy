§λ("discoveries")
§ω("singular.v15.discovery")
§κ("DISC-000035-F")

Ω ⟦ Ψ_0 : ⛨ℝ[82, 121], W_0 : ℝ[121, 121], K_0 : ℝ[82, 121], δ_0 : Δℝ[22], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_MOE(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
