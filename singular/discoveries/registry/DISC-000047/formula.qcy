// DISC-000047 Formula — SystemVerilog-2017 Causal Compute Unit (Ω-CCU / ⟁_RTL)
§λ("discoveries")
§ω("18.0")
§κ("⛨-47")

Ω ⟦ Ψ_0 : ⛨ℝ[151, 64], W_0 : ℝ[64, 64], δ_0 : Δℝ[16], S_0 : ⛨ℝ[151, 64] ⟧ {
  Ψ_1 ← ⟁_RTL(Ψ_0, δ_0)
  Ψ_2 ← φ₊(Ψ_0 ⋅ W_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_1| < ∞
}
