// SINGULAR Ω v25.0 — ACSR Zero-Matvec Step-0 Subspace Projection Beating Thick-Restart Recycled Krylov
§λ("discoveries")
§ω("singular.v25.proof.exp")
§κ("DISC-000089-E")

Ω ⟦ Ψ_0 : ⛨ℝ[131, 181], W_0 : ℝ[181, 181], K_0 : ℝ[131, 181], δ_0 : Δℝ[65], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φτ(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⨂_TM(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
