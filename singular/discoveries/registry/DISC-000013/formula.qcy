Ω ⟦
  Ψ_1118 : ℝ[56, 80],
  W_1118 : ℝ[80, 80],
  b_1118 : ℝ[56, 80],
  δ_1118 : Δℝ[12],
  S_1118 : ⛨ℝ[56, 80],
  ω_1118 : 𝕊[∞]
⟧ {
  Φ_1118 ← φ₊(Ψ_1118 ⋅ W_1118 + b_1118)
  Θ_1118 ← Φ_1118 ⊕ δ_1118
  Υ_1118 ← ⛨(Θ_1118, S_1118) + ∇_g(Φ_1118) + ⋆(d(ω_1118) ∧ d(Φ_1118))
  Ξ_1118 ← (Θ_1118 ↶ δ_1118) ⋈ W_1118 + H¹_Sheaf(Υ_1118) + ∑∞(ω_1118)
  ⊢ ⇄(Φ_1118, Ξ_1118)
  ⊢ d(d(ω_1118)) ≈ 0.0
