§λ("discoveries")
§ω("singular.discoveries.registry")
§κ("DISC-000014")

Ω ⟦
  Ψ_1132 : ℝ[40, 112],
  W_1132 : ℝ[112, 112],
  b_1132 : ℝ[40, 112],
  δ_1132 : Δℝ[20],
  S_1132 : ⛨ℝ[40, 112],
  ω_1132 : 𝕊[∞]
⟧ {
  Φ_1132 ← φ₊(Ψ_1132 ⋅ W_1132 + b_1132)
  Θ_1132 ← Φ_1132 ⊕ δ_1132
  Υ_1132 ← ⛨(Θ_1132, S_1132) + ∇_g(Φ_1132) + ⋆(d(ω_1132) ∧ d(Φ_1132))
  Ξ_1132 ← (Θ_1132 ↶ δ_1132) ⋈ W_1132 + H¹_Sheaf(Υ_1132) + ∑∞(ω_1132)
  ⊢ ⇄(Φ_1132, Ξ_1132)
  ⊢ d(d(ω_1132)) ≈ 0.0
  ⊢ |Υ_1132| < ∞
}
