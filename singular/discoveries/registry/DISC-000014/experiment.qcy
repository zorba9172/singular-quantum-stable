§λ("verification")
§ω("singular.discoveries.registry")
§κ("DISC-000014-EXP")

Ω ⟦
  Ψ_1131 : ℝ[32, 96],
  W_1131 : ℝ[96, 96],
  b_1131 : ℝ[32, 96],
  δ_1131 : Δℝ[16],
  S_1131 : ⛨ℝ[32, 96],
  ω_1131 : 𝕊[∞]
⟧ {
  Φ_1131 ← φ₊(Ψ_1131 ⋅ W_1131 + b_1131)
  Θ_1131 ← Φ_1131 ⊕ δ_1131
  Υ_1131 ← ⛨(Θ_1131, S_1131) + ∇_g(Φ_1131) + ⋆(d(ω_1131) ∧ d(Φ_1131))
  Ξ_1131 ← (Θ_1131 ↶ δ_1131) ⋈ W_1131 + H¹_Sheaf(Υ_1131) + ∑∞(ω_1131)
  ⊢ ⇄(Φ_1131, Ξ_1131)
  ⊢ d(d(ω_1131)) ≈ 0.0
  ⊢ |Υ_1131| < ∞
}
