§κ("DISC-000032-FORMULA")

Ω ⟦ ω_0 : 𝕊[4096], Ψ_0 : ⛨ℝ[54, 96], W_0 : ℝ[96, 96], T_0 : ℤ[256, 4], A_0 : ℤ[128, 8], C_0 : ℤ[64, 12], δ_0 : Δℝ[14], ξ_0 : ⚿[32] ⟧ {
  T_0 ← ⟁_LEX(ω_0, Ψ_0)
  A_0 ← ⟁_AST(T_0, W_0)
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  C_0 ← ⟁_CIR(A_0, Ψ_1)
