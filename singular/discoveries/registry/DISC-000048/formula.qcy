// DISC-000048 Formula — RISC-V custom-3 (0x7B) Ω-ISA & Reversible Hardware ALU (⟁_ISA)
§λ("discoveries")
§ω("18.0")
§κ("⛨-48")

Ω ⟦ Ψ_0 : ⛨ℝ[153, 64], W_0 : ℝ[64, 64], δ_0 : Δℝ[16], Z_0 : ℤ[16] ⟧ {
  Ψ_1 ← ⟁_ISA(Ψ_0, δ_0)
  Ψ_2 ← φτ(Ψ_0 ⋅ W_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_1| < ∞
}
