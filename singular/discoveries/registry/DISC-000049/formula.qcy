// §λ("discoveries") §ω("18.0") §κ("⛨-49")
// DISC-000049 Formula — SARC Near-Memory SRAM Compute Fabric (Ω-NMC / ⟁_NMC)
§λ("discoveries")
§ω("18.0")
§κ("⛨-49")

Ω ⟦ Ψ_0 : ⛨ℝ[155, 64], W_0 : ℝ[64, 64], δ_0 : Δℝ[16], E_0 : ℤ[8] ⟧ {
  Ψ_1 ← ⟁_NMC(Ψ_0, δ_0)
  Ψ_2 ← ⟁_SARC(Ψ_1, δ_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_1| < ∞
}
