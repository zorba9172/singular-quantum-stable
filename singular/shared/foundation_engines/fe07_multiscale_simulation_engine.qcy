// SINGULAR Ω v14.0 — fe07_multiscale_simulation_engine.qcy
§λ("shared")
§ω("singular.v14.foundation")
§κ("CY-FE-07")

Ω ⟦ Ψ_0 : ⛨ℝ[18, 122], W_0 : ℝ[122, 122], K_0 : ℝ[18, 122], δ_0 : Δℝ[14], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ↦(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
