// SINGULAR Ω v14.0 — fe04_adaptive_numerical_solver_engine.qcy
§λ("shared")
§ω("singular.v14.foundation")
§κ("CY-FE-04")

Ω ⟦ Ψ_0 : ⛨ℝ[70, 101], W_0 : ℝ[101, 101], K_0 : ℝ[70, 101], δ_0 : Δℝ[11], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_AMC(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
