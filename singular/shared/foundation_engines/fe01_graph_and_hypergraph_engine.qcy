// SINGULAR Ω v14.0 — fe01_graph_and_hypergraph_engine.qcy
§λ("shared")
§ω("singular.v14.foundation")
§κ("CY-FE-01")

Ω ⟦ Ψ_0 : ⛨ℝ[64, 80], W_0 : ℝ[80, 80], K_0 : ℝ[64, 80], δ_0 : Δℝ[8], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_ACG(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
