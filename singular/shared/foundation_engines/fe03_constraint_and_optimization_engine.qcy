// SINGULAR Ω v14.0 — fe03_constraint_and_optimization_engine.qcy
§λ("shared")
§ω("singular.v14.foundation")
§κ("CY-FE-03")

Ω ⟦ Ψ_0 : ⛨ℝ[68, 94], W_0 : ℝ[94, 94], K_0 : ℝ[68, 94], δ_0 : Δℝ[10], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⊕_trop(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
