// SINGULAR Ω v14.0 — fe08_causal_learning_engine.qcy
§λ("shared")
§ω("singular.v14.foundation")
§κ("CY-FE-08")

Ω ⟦ Ψ_0 : ⛨ℝ[20, 33], W_0 : ℝ[33, 33], K_0 : ℝ[20, 33], δ_0 : Δℝ[15], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⊥_Σ(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
