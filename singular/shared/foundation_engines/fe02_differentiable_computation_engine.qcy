// SINGULAR Ω v14.0 — fe02_differentiable_computation_engine.qcy
§λ("shared")
§ω("singular.v14.foundation")
§κ("CY-FE-02")

Ω ⟦ Ψ_0 : ⛨ℝ[66, 87], W_0 : ℝ[87, 87], K_0 : ℝ[66, 87], δ_0 : Δℝ[9], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ∇_g(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
