§λ("shared")
§ω("singular.v14.foundation")
§κ("CY-FE-06")

Ω ⟦ Ψ_0 : ⛨ℝ[16, 115], W_0 : ℝ[115, 115], K_0 : ℝ[16, 115], δ_0 : Δℝ[13], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ◈_H(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
