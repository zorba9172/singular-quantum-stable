@@ -0,0 +1,40 @@
+#include "cycraft/quantum_syntax/omega_executable_grammar.hpp"
+#include "cycraft/quantum_syntax/omega_executable_incremental.hpp"
+#include <array>
+#include <chrono>
+#include <iomanip>
+#include <iostream>
+#include <optional>
+using namespace cycraft::omega::executable;
+constexpr size_t branches=32,width=128,steps=1000,samples=19;
+using Matrix=std::array<std::array<double,width>,branches>;
+std::string source() {
+    std::ostringstream o;o<<"§λ(\"verification\")\n§ω(\"synthetic-benchmark\")\n§κ(\"fp64-ordered\")\nΩ ⟦ ";
+    for(size_t b=0;b<branches;++b)o<<(b?",":"")<<"α_"<<b<<" : ℝ["<<width<<"], β_"<<b<<" : ℝ["<<width<<"]";
+    o<<" ⟧ {\n";
+    for(size_t b=0;b<branches;++b){o<<"α_"<<b<<" ← [";for(size_t j=0;j<width;++j)o<<(j?",":"")<<double(j)/8-8;
+        o<<"]\nβ_"<<b<<" ← φ₊(α_"<<b<<" * 0.5 + 1)\n";}
+    o<<"⊢ β_0 == β_0\n}\n";return o.str();
+}
+void transform(const std::array<double,width>& in,std::array<double,width>& out){for(size_t j=0;j<width;++j)out[j]=std::max(0.0,in[j]*0.5+1);}
+std::array<double,width> event(size_t step) {std::array<double,width> a{};for(size_t j=0;j<width;++j)a[j]=double((step+j)%257)/8-8;return a;}
+double checksum(const Matrix& m){double s=0;for(const auto& row:m)for(double x:row)s+=x;return s;}
+Matrix extract(const Incremental& vm){Matrix m{};for(size_t b=0;b<branches;++b){auto id=vm.program().outputs.at("β_"+std::to_string(b));std::copy(vm.state()[id].data.begin(),vm.state()[id].data.end(),m[b].begin());}return m;}
+int main(){try{
+    Program p=parse(source());std::cout<<"implementation,sample,update_ns_per_event,setup_ns,checksum,correct,workload\n";
+    for(size_t sample=0;sample<samples;++sample)for(size_t slot=0;slot<4;++slot){
+        size_t mode=(slot+sample)%4;auto start=std::chrono::steady_clock::now();std::optional<Incremental> vm;if(mode<2)vm.emplace(p);Matrix in{},out{};
+        for(size_t b=0;b<branches;++b){for(size_t j=0;j<width;++j)in[b][j]=double(j)/8-8;transform(in[b],out[b]);}
+        auto ready=std::chrono::steady_clock::now();
+        for(size_t s=0;s<steps;++s){size_t b=s%branches;auto a=event(s);
+            if(mode<2)vm->update("α_"+std::to_string(b),Value{{width},{a.begin(),a.end()}},mode==1);
+            else{in[b]=a;if(mode==2)for(size_t k=0;k<branches;++k)transform(in[k],out[k]);else transform(in[b],out[b]);}
+            asm volatile("" : : "g"(out.data()) : "memory");
+        }
+        auto end=std::chrono::steady_clock::now();Matrix actual=mode<2?extract(*vm):out;
+        Matrix oracle{};for(size_t b=0;b<branches;++b){size_t last=(steps-1)-((steps-1+branches-b)%branches);auto a=event(last);transform(a,oracle[b]);}
+        bool correct=actual==oracle;const char* names[]={"qcy_full","qcy_incremental","cpp_full","cpp_incremental"};
+        std::cout<<names[mode]<<','<<sample<<','<<std::chrono::duration<double,std::nano>(end-ready).count()/steps<<','<<std::chrono::duration<double,std::nano>(ready-start).count()<<','<<std::setprecision(17)<<checksum(actual)<<','<<correct<<",synthetic_32x128_relu_independent_branches\n";
+        if(!correct)return 1;
+    }
+}catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 1;}}
