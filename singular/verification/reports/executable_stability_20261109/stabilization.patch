+#!/usr/bin/env bash
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
+cd "$ROOT"
+BIN="$ROOT/bin/singular-quantum"
+OUT="${1:?provide an evidence directory outside the source tree}"
+mkdir -p "$OUT"
+TMP="$(mktemp -d)"
+trap 'rm -rf "$TMP"' EXIT
+"$BIN" verify-all > "$OUT/smoke.json"
+"$BIN" enforce "$ROOT/singular/modules/executable" > "$OUT/enforcement.json"
+"$BIN" run singular/modules/executable/matrix.qcy > "$OUT/vm.jsonl"
+"$BIN" compile-native singular/modules/executable/matrix.qcy "$TMP/native"
+"$TMP/native" > "$OUT/native.jsonl"
+"$BIN" jit singular/modules/executable/matrix.qcy > "$OUT/jit.jsonl"
+diff -u "$OUT/vm.jsonl" "$OUT/native.jsonl"
+diff -u "$OUT/vm.jsonl" "$OUT/jit.jsonl"
+# Independent hand-calculated matrix result, not another call to the same kernel.
+[ "$(jq -c 'select(.symbol=="γ")|.values' "$OUT/vm.jsonl")" = '[17,39]' ]
+[ "$(jq -c 'select(.symbol=="δ")|.values' "$OUT/vm.jsonl")" = '[0,19]' ]
+reject() {
+    if "$BIN" run "$TMP/reject.qcy" > "$TMP/reject.out" 2> "$TMP/reject.err"; then
+        echo "Unexpected acceptance: $1" >&2;exit 1
+    fi
+    grep -F "$2" "$TMP/reject.err" >/dev/null
+    printf '%s: rejected (%s)\n' "$1" "$2" >> "$OUT/rejections.txt"
+}
+: > "$OUT/rejections.txt"
+sed 's/\[17,39\]/[17,40]/' singular/modules/executable/matrix.qcy > "$TMP/reject.qcy"
+reject false-assertion E_ASSERT
+sed 's/Α ⋅ β/∇(β)/' singular/modules/executable/matrix.qcy > "$TMP/reject.qcy"
+reject unsupported-operator E_UNINITIALIZED
+sed '/β ←/d' singular/modules/executable/matrix.qcy > "$TMP/reject.qcy"
+reject uninitialized-input E_UNINITIALIZED
+sed 's/ℝ\[2,2\]/ℝ[999999999999999999999999999,2]/' singular/modules/executable/matrix.qcy > "$TMP/reject.qcy"
+reject overflowing-dimension E_SHAPE
+sed 's/Α ⋅ β/β \/ 0/' singular/modules/executable/matrix.qcy > "$TMP/reject.qcy"
+reject numeric-fault E_NUMERIC
+sed '$d' singular/modules/executable/matrix.qcy > "$TMP/reject.qcy"
+reject unclosed-body E_SYNTAX
+printf '\377' > "$TMP/reject.qcy"
+reject invalid-utf8 E_UTF8
+cat > "$TMP/events.qcy" <<'EVENTS'
+α ← [4,5]
+↶
+α ← [-1,2]
+EVENTS
+cat > "$TMP/reactor.qcy" <<'PROGRAM'
+§λ("core")
+§ω("agent.events")
+§κ("transactional")
+Ω ⟦ α : ℝ[2], β : ℝ[2] ⟧ {
+α ← [2,3]
+β ← φ₊(α * 2 + 1)
+⊢ β == φ₊(α * 2 + 1)
+}
+PROGRAM
+"$BIN" replay "$TMP/reactor.qcy" "$TMP/events.qcy" > "$OUT/incremental.jsonl" 2> "$OUT/incremental-timing.jsonl"
+"$BIN" replay-full "$TMP/reactor.qcy" "$TMP/events.qcy" > "$OUT/full.jsonl" 2> "$OUT/full-timing.jsonl"
+diff -u "$OUT/incremental.jsonl" "$OUT/full.jsonl"
+[ "$(jq -sc '[.[]|select(.symbol=="β")|.values]' "$OUT/incremental.jsonl")" = '[[9,11],[5,7],[0,5]]' ]
+printf '%s\n' '{"vm_native_jit":"identical","matrix_oracle":"matched","invalid_inputs":"rejected","incremental_full_undo":"matched","scientific_advantage":null}' > "$OUT/validation.json"
+cat "$OUT/validation.json"
