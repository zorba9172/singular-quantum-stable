+#include "cycraft/quantum_syntax/omega_executable_grammar.hpp"
+#include "cycraft/quantum_syntax/omega_executable_incremental.hpp"
+#include <iostream>
+using namespace cycraft::omega::executable;
+int main(){try{
+    const std::string src="§λ(\"verification\") §ω(\"invariants\") §κ(\"exact-observed\")\nΩ ⟦ α:ℝ[3], β:ℝ[3], γ:ℝ[1] ⟧ {\nα ← [0,1,2]\nβ ← φ₊(α * 2 + 1)\nγ ← ∑(β)\n⊢ γ == ∑(β)\n}\n";
+    auto p=parse(src);Incremental sparse(p),full(p);size_t comparisons=0;
+    for(int k=-64;k<=64;++k){
+        Value x{{3},{double(k)/8,double(k+1)/8,-double(k)/8}};
+        sparse.update("α",x);full.update("α",x,false);
+        for(size_t n=0;n<p.nodes.size();++n){if(!identical(sparse.state()[n],full.state()[n]))throw Error("sparse/full mismatch");++comparisons;}
+        const auto& y=sparse.state()[p.outputs.at("β")].data;
+        double expected=0;
+        for(size_t j=0;j<3;++j){double v=x.data[j]*2+1;double oracle=v>0?v:0;if(y[j]!=oracle)throw Error("independent activation oracle");expected+=oracle;}
+        if(sparse.state()[p.outputs.at("γ")].data[0]!=expected)throw Error("independent reduction oracle");
+        auto before=sparse.state();sparse.update("α",x);if(sparse.evaluated!=0)throw Error("no-change did work");sparse.undo();
+        for(size_t n=0;n<p.nodes.size();++n)if(!identical(sparse.state()[n],before[n]))throw Error("undo mismatch");
+    }
+    bool rejected=false;auto before=sparse.state();
+    try{sparse.update("α",Value{{3},{std::numeric_limits<double>::max(),1,2}});}catch(const Error&){rejected=true;}
+    if(!rejected)throw Error("overflow not rejected");
+    for(size_t n=0;n<p.nodes.size();++n)if(!identical(before[n],sparse.state()[n]))throw Error("numeric failure not atomic");
+    auto aliases=parse("§λ(\"core\") §ω(\"alias\") §κ(\"shape\") Ω ⟦ α:ℝ[2], β:ℝ[2] ⟧ { α ← [1,2] β ← α ⊢ β == [1,2] }");
+    if(aliases.inputs.count("β"))throw Error("alias incorrectly writable");
+    std::cout<<"{\"deterministic_states\":129,\"node_comparisons\":"<<comparisons<<",\"oracle\":\"independent scalar arithmetic\",\"atomic_numeric_failure\":true,\"exact_undo\":true}\n";
+}catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 1;}}
