+namespace cycraft::omega::executable {
+struct Token { std::string text; size_t line=1; bool number=false,quoted=false; };
+class Lexer {
+    std::string src_; size_t pos_=0,line_=1;
+public:
+    Token token;
+    explicit Lexer(std::string s):src_(std::move(s)) {
+        if(src_.size()>1<<20) throw Error("E_BUDGET: source exceeds 1 MiB");
+        for(size_t i=0;i<src_.size();) {
+            unsigned char lead=src_[i++];uint32_t cp=lead;size_t continuation=0;uint32_t minimum=0;
+            if(lead>=0xc2&&lead<=0xdf){cp=lead&31;continuation=1;minimum=0x80;}
+            else if(lead>=0xe0&&lead<=0xef){cp=lead&15;continuation=2;minimum=0x800;}
+            else if(lead>=0xf0&&lead<=0xf4){cp=lead&7;continuation=3;minimum=0x10000;}
+            else if(lead>=128)throw Error("E_UTF8: invalid leading byte");
+            while(continuation--){if(i>=src_.size()||(static_cast<unsigned char>(src_[i])&0xc0)!=0x80)throw Error("E_UTF8: invalid continuation");cp=(cp<<6)|(src_[i++]&63);}
+            if(cp<minimum||cp>0x10ffff||(cp>=0xd800&&cp<=0xdfff))throw Error("E_UTF8: invalid code point");
+            if((cp>=0x202a&&cp<=0x202e)||(cp>=0x2066&&cp<=0x2069)||cp==0x200b||cp==0xfeff)throw Error("E_UTF8: invisible/bidi character");
+        }
+        next();
+    }
+    void next() {
+        while(pos_<src_.size()) {
+            unsigned char c=src_[pos_];
+            if(c=='#' || src_.compare(pos_,2,"//")==0) {while(pos_<src_.size()&&src_[pos_]!='\n') ++pos_;continue;}
+            if(std::isspace(c)) {if(c=='\n'&&++line_>400) throw Error("E_BUDGET: source lines");++pos_;continue;}
+            break;
+        }
+        token={"",line_};if(pos_==src_.size()) return;
+        if(src_[pos_]=='"') {
+            size_t start=++pos_;
+            while(pos_<src_.size()&&src_[pos_]!='"') {
+                if(src_[pos_]=='\\'||static_cast<unsigned char>(src_[pos_])<32) throw Error("E_STRING: escapes/control characters are not supported");++pos_;
+            }
+            if(pos_==src_.size()) throw Error("E_STRING: unterminated string");
+            token={src_.substr(start,pos_-start),line_,false,true};++pos_;return;
+        }
+        for(const char* op:{"§λ","§ω","§κ","⟦","⟧","←","⊢","⊕","⊗","⋅","=="}) {
+            std::string s(op);if(src_.compare(pos_,s.size(),s)==0){token.text=s;pos_+=s.size();return;}
+        }
+        char c=src_[pos_];
+        if(std::string("[](){},:+-*/").find(c)!=std::string::npos){token.text=src_.substr(pos_++,1);return;}
+        size_t start=pos_;
+        if(std::isdigit(static_cast<unsigned char>(c)) || c=='.') {
+            double value;const char* first=src_.data()+pos_;
+            auto r=std::from_chars(first,src_.data()+src_.size(),value);
+            if(r.ec!=std::errc{} || r.ptr==first || !std::isfinite(value)) throw Error("E_NUMBER: invalid or non-finite number");
+            pos_=static_cast<size_t>(r.ptr-src_.data());token={src_.substr(start,pos_-start),line_,true};return;
+        }
+        while(pos_<src_.size()) {
+            unsigned char b=src_[pos_];
+            if(b<128 && !(std::isalnum(b)||b=='_')) break;
+            bool boundary=false;
+            for(const char* op:{"⟦","⟧","←","⊢","⊕","⊗","⋅"}) if(src_.compare(pos_,std::string(op).size(),op)==0) boundary=true;
+            if(boundary) break;++pos_;
+        }
+        if(pos_==start) throw Error("E_TOKEN: unsupported byte at line "+std::to_string(line_));
+        token.text=src_.substr(start,pos_-start);
+    }
+    bool take(const std::string& t) {if(!token.quoted&&token.text==t){next();return true;}return false;}
+    void need(const std::string& t) {if(!take(t)) throw Error("E_SYNTAX: expected "+t+" at line "+std::to_string(token.line));}
+    std::string identifier() {
+        const auto t=token;
+        if(t.text.empty()||t.number||t.quoted) throw Error("E_NAME: identifier expected");
+        for(unsigned char c:t.text) if(c<128&&!(std::isalnum(c)||c=='_')) throw Error("E_NAME: invalid identifier");
+        if(t.text=="Ω"||t.text=="ℝ"||t.text=="φ₊"||t.text=="φτ"||t.text=="φσ"||t.text=="∑") throw Error("E_NAME: reserved symbol");
+        next();return t.text;
+    }
+    double number() {
+        bool minus=take("-");if(!minus)take("+");
+        if(!token.number) throw Error("E_NUMBER: numeric literal expected");
+        double x=0;auto r=std::from_chars(token.text.data(),token.text.data()+token.text.size(),x);
+        if(r.ec!=std::errc{}||!std::isfinite(x))throw Error("E_NUMBER: invalid number");next();return minus?-x:x;
+    }
+};
+class Grammar {
+    Lexer lex_; Program p_; std::map<std::string,Shape> declarations_; size_t depth_=0;
+    size_t primary() {
+        if(++depth_>64) throw Error("E_BUDGET: expression depth");
+        size_t result, line=lex_.token.line;
+        if(lex_.take("-")) {size_t a=primary();result=p_.operation(Op::neg,a,a,line);}
+        else if(lex_.take("(")) {result=expression();lex_.need(")");}
+        else if(lex_.take("[")) {
+            Value v;
+            do {if(v.data.size()>=max_elements)throw Error("E_BUDGET: literal");v.data.push_back(lex_.number());}while(lex_.take(","));
+            lex_.need("]");v.shape={v.data.size()};result=p_.literal(std::move(v),line);
+        } else if(lex_.token.number) result=p_.literal(Value{{1},{lex_.number()}},line);
+        else {
+            std::string name=lex_.token.text;
+            if(name=="φ₊"||name=="φτ"||name=="φσ"||name=="∑") {
+                lex_.next();lex_.need("(");size_t a=expression();lex_.need(")");
+                Op op=name=="φ₊"?Op::relu:name=="φτ"?Op::tanh:name=="φσ"?Op::sigmoid:Op::sum;
+                result=p_.operation(op,a,a,line);
+            } else {
+                name=lex_.identifier();auto it=p_.outputs.find(name);
+                if(it==p_.outputs.end()) throw Error("E_UNINITIALIZED: "+name+" at line "+std::to_string(line));result=it->second;
+            }
+        }
+        --depth_;return result;
+    }
+    size_t expression(int minimum=0) {
+        size_t a=primary();
+        while(true) {
+            std::string t=lex_.token.text; int precedence;Op op;
+            if(t=="+"||t=="⊕") {precedence=1;op=Op::add;}
+            else if(t=="-"){precedence=1;op=Op::sub;}
+            else if(t=="*"){precedence=2;op=Op::mul;}
+            else if(t=="/"){precedence=2;op=Op::div;}
+            else if(t=="⋅"){precedence=2;op=Op::matmul;}
+            else if(t=="⊗"){precedence=2;op=Op::kron;}
+            else break;
+            if(precedence<minimum)break;size_t line=lex_.token.line;lex_.next();
+            size_t b=expression(precedence+1);a=p_.operation(op,a,b,line);
+        }
+        return a;
+    }
+public:
+    explicit Grammar(const std::string& src):lex_(src) {}
+    Program parse() {
+        std::set<std::string> metadata;
+        for(int i=0;i<3;++i) {
+            std::string tag=lex_.token.text;
+            if(tag!="§λ"&&tag!="§ω"&&tag!="§κ")throw Error("E_HEADER: expected layer, owner and contract");
+            if(!metadata.insert(tag).second)throw Error("E_HEADER: duplicate metadata");
+            lex_.next();lex_.need("(");
+            if(!lex_.token.quoted||lex_.token.text.empty())throw Error("E_HEADER: nonempty quoted value required");
+            if(tag=="§λ"&&!quantum_syntax::valid_canonical_layer(lex_.token.text))throw Error("E_HEADER: unknown layer");
+            lex_.next();lex_.need(")");
+        }
+        lex_.need("Ω");lex_.need("⟦");
+        do {
+            std::string name=lex_.identifier();lex_.need(":");lex_.need("ℝ");lex_.need("[");Shape s;
+            do {
+                if(!lex_.token.number)throw Error("E_SHAPE: literal positive integer required");
+                size_t n=0;const auto& t=lex_.token.text;auto r=std::from_chars(t.data(),t.data()+t.size(),n);
+                if(r.ec!=std::errc{}||r.ptr!=t.data()+t.size()||!n)throw Error("E_SHAPE: invalid dimension");
+                s.push_back(n);if(s.size()>2)throw Error("E_SHAPE: rank exceeds 2");lex_.next();
+            }while(lex_.take(","));lex_.need("]");elements(s);
+            if(!declarations_.emplace(name,s).second)throw Error("E_NAME: duplicate declaration "+name);
+            if(declarations_.size()>256)throw Error("E_BUDGET: declarations");
+        }while(lex_.take(","));
+        lex_.need("⟧");lex_.need("{");
+        while(!lex_.take("}")) {
+            size_t line=lex_.token.line;
+            if(lex_.token.text.empty())throw Error("E_SYNTAX: unclosed body");
+            if(lex_.take("⊢")) {
+                size_t a=expression();lex_.need("==");size_t b=expression();
+                if(p_.nodes[a].shape!=p_.nodes[b].shape)throw Error("E_SHAPE: assertion operands");
+                p_.checks.push_back({a,b,line});
+            } else {
+                std::string name=lex_.identifier();auto d=declarations_.find(name);
+                if(d==declarations_.end())throw Error("E_UNDECLARED: "+name);
+                if(p_.outputs.count(name))throw Error("E_SSA: duplicate assignment; use replay for input updates");
+                lex_.need("←");size_t first_new=p_.nodes.size();size_t id=expression();auto& node=p_.nodes[id];
+                if(node.op==Op::literal && id>=first_new && elements(d->second)==node.literal.data.size()) {
+                    node.shape=d->second;node.literal.shape=d->second;p_.inputs[name]=id;
+                }
+                if(node.shape!=d->second)throw Error("E_SHAPE: assignment to "+name);
+                p_.outputs[name]=id;
+            }
+        }
+        if(!lex_.token.text.empty())throw Error("E_SYNTAX: trailing tokens");
+        if(p_.outputs.size()!=declarations_.size())throw Error("E_UNINITIALIZED: every declaration requires an assignment");
+        if(p_.checks.empty())throw Error("E_CONTRACT: an executable equality assertion is required");
+        return std::move(p_);
+    }
+};
+inline Program parse(const std::string& src) {return Grammar(src).parse();}
+} // namespace cycraft::omega::executable
diff --git a/cycraft/include/cycraft/quantum_syntax/omega_executable_incremental.hpp b/cycraft/include/cycraft/quantum_syntax/omega_executable_incremental.hpp
new file mode 100644
index 0000000..1482ed5
--- /dev/null
+++ b/cycraft/include/cycraft/quantum_syntax/omega_executable_incremental.hpp
@@ -0,0 +1,56 @@
+#pragma once
+#include "cycraft/quantum_syntax/omega_executable_ir.hpp"
+#include <queue>
+namespace cycraft::omega::executable {
+// Exact cache admission: immutable typed DAG, one ordered event transaction,
+// bit-identical cached values, and executable postconditions. No hash-only hits.
+class Incremental {
+    Program p_;std::vector<Value> state_;
+    std::vector<std::vector<size_t>> users_;
+    std::vector<std::pair<size_t,Value>> undo_;
+    bool can_undo_=false;
+public:
+    size_t evaluated=0,cutoffs=0;
+    explicit Incremental(Program p):p_(std::move(p)),state_(interpret(p_)),users_(p_.nodes.size()) {
+        for(size_t i=0;i<p_.nodes.size();++i)if(p_.nodes[i].op!=Op::literal) {
+            users_[p_.nodes[i].a].push_back(i);
+            if(p_.nodes[i].b!=p_.nodes[i].a)users_[p_.nodes[i].b].push_back(i);
+        }
+    }
+    const std::vector<Value>& state()const{return state_;}
+    const Program& program()const{return p_;}
+    bool can_undo()const{return can_undo_;}
+    void update(const std::string& name,Value value,bool incremental=true) {
+        auto it=p_.inputs.find(name);if(it==p_.inputs.end())throw Error("E_INPUT: not an independent literal input: "+name);
+        validate(value);size_t id=it->second;
+        if(value.shape!=state_[id].shape)throw Error("E_SHAPE: update changes type");
+        std::vector<std::pair<size_t,Value>> changes;changes.reserve(p_.nodes.size());
+        evaluated=0;cutoffs=0;
+        auto replace=[&](size_t n,Value v){changes.emplace_back(n,std::move(state_[n]));state_[n]=std::move(v);};
+        try {
+            replace(id,std::move(value));
+            if(incremental) {
+                std::priority_queue<size_t,std::vector<size_t>,std::greater<size_t>> ready;
+                std::vector<bool> queued(p_.nodes.size(),false);
+                auto schedule=[&](size_t n){for(size_t user:users_[n])if(!queued[user]){queued[user]=true;ready.push(user);}};
+                if(!identical(changes.back().second,state_[id]))schedule(id);else ++cutoffs;
+                while(!ready.empty()) {
+                    size_t n=ready.top();ready.pop();Value next=evaluate(p_.nodes[n],state_);++evaluated;
+                    if(identical(next,state_[n])){++cutoffs;continue;}
+                    replace(n,std::move(next));schedule(n);
+                }
+            }else {
+                for(size_t n=0;n<p_.nodes.size();++n)if(p_.nodes[n].op!=Op::literal){replace(n,evaluate(p_.nodes[n],state_));++evaluated;}
+            }
+            for(const auto& c:p_.checks)assertion(state_[c.a],state_[c.b],c.line);
+        }catch(...){for(auto i=changes.rbegin();i!=changes.rend();++i)state_[i->first]=std::move(i->second);throw;}
+        undo_=std::move(changes);can_undo_=true;
+    }
+    void undo() {
+        if(!can_undo_)throw Error("E_UNDO: no committed transaction");
+        evaluated=0;cutoffs=0;
+        for(auto i=undo_.rbegin();i!=undo_.rend();++i)state_[i->first]=std::move(i->second);
+        undo_.clear();can_undo_=false;
+    }
+};
+} // namespace cycraft::omega::executable
diff --git a/cycraft/include/cycraft/quantum_syntax/omega_executable_ir.hpp b/cycraft/include/cycraft/quantum_syntax/omega_executable_ir.hpp
new file mode 100644
index 0000000..ef9e080
--- /dev/null
+++ b/cycraft/include/cycraft/quantum_syntax/omega_executable_ir.hpp
@@ -0,0 +1,45 @@
+#pragma once
+#include "cycraft/quantum_syntax/omega_executable_value.hpp"
+#include <map>
+#include <tuple>
+namespace cycraft::omega::executable {
+struct Node { Op op=Op::literal; size_t a=0,b=0,line=0; Value literal; Shape shape; };
+struct Check { size_t a,b,line; };
+struct Program {
+    std::vector<Node> nodes;
+    std::vector<Check> checks;
+    std::map<std::string,size_t> outputs,inputs;
+    std::map<std::tuple<Op,size_t,size_t>,size_t> expressions;
+    size_t bytes=0;
+    size_t add(Node n) {
+        if(nodes.size()>=max_nodes) throw Error("E_BUDGET: IR nodes");
+        size_t cost=elements(n.shape)*sizeof(double);
+        if(cost>max_bytes/8-bytes) throw Error("E_BUDGET: live values, IR literals and transaction reserve");
+        bytes+=cost; nodes.push_back(std::move(n)); return nodes.size()-1;
+    }
+    size_t literal(Value v,size_t line) {
+        validate(v); Node n; n.line=line;n.shape=v.shape;n.literal=std::move(v);return add(std::move(n));
+    }
+    size_t operation(Op op,size_t a,size_t b,size_t line) {
+        // Pure ordered operands only: no reassociation, FMA contraction or
+        // approximate/hash-only reuse; input literals are never interned.
+        auto key=std::tuple{op,a,b};auto found=expressions.find(key);
+        if(found!=expressions.end())return found->second;
+        Node n; n.op=op;n.a=a;n.b=b;n.line=line;
+        n.shape=shape_of(op,nodes.at(a).shape,nodes.at(b).shape);size_t id=add(std::move(n));expressions.emplace(key,id);return id;
+    }
+};
+inline Value evaluate(const Node& n,const std::vector<Value>& state) {
+    if(n.op==Op::literal) return n.literal;
+    return apply(n.op,state.at(n.a),state.at(n.b));
+}
+inline std::vector<Value> interpret(const Program& p) {
+    std::vector<Value> state;state.reserve(p.nodes.size());
+    for(const auto& n:p.nodes) state.push_back(evaluate(n,state));
+    for(const auto& c:p.checks) assertion(state.at(c.a),state.at(c.b),c.line);
+    return state;
+}
+inline void output(const Program& p,const std::vector<Value>& state,std::ostream& o=std::cout) {
+    for(const auto& [name,id]:p.outputs) print_value(o,name,state.at(id));
+}
+} // namespace cycraft::omega::executable
diff --git a/cycraft/include/cycraft/quantum_syntax/omega_executable_native.hpp b/cycraft/include/cycraft/quantum_syntax/omega_executable_native.hpp
new file mode 100644
index 0000000..5c0517d
--- /dev/null
+++ b/cycraft/include/cycraft/quantum_syntax/omega_executable_native.hpp
@@ -0,0 +1,48 @@
+#pragma once
+#include "cycraft/quantum_syntax/omega_executable_ir.hpp"
+#include "cycraft/quantum_syntax/omega_executable_process.hpp"
+#include <dlfcn.h>
+#include <sstream>
+namespace cycraft::omega::executable {
+inline std::string value_source(const Value& v) {
+    std::ostringstream o;o<<"Value{{";
+    for(size_t i=0;i<v.shape.size();++i)o<<(i?",":"")<<v.shape[i];o<<"},{"<<std::hexfloat;
+    for(size_t i=0;i<v.data.size();++i)o<<(i?",":"")<<v.data[i];o<<"}}";return o.str();
+}
+inline std::string native_source(const Program& p,bool library) {
+    std::ostringstream o;
+    o<<"#include \"cycraft/quantum_syntax/omega_executable_value.hpp\"\nusing namespace cycraft::omega::executable;\n";
+    o<<(library?"extern \"C\" int singular_entry()":"int main()")<<" {try {\n";
+    for(size_t i=0;i<p.nodes.size();++i) {
+        const auto& n=p.nodes[i];o<<"Value v"<<i<<"=";
+        if(n.op==Op::literal)o<<value_source(n.literal);
+        else o<<"apply(static_cast<Op>("<<static_cast<int>(n.op)<<"),v"<<n.a<<",v"<<n.b<<")";
+        o<<";\n";
+    }
+    for(const auto& c:p.checks)o<<"assertion(v"<<c.a<<",v"<<c.b<<","<<c.line<<");\n";
+    for(const auto& [name,id]:p.outputs)o<<"print_value(std::cout,"<<quote(name)<<",v"<<id<<");\n";
+    o<<"return 0;}catch(const std::exception& e){std::cerr<<e.what()<<'\\n';return 1;}}\n";return o.str();
+}
+inline std::filesystem::path compile(const Program& p,const std::filesystem::path& include,
+                                     TemporaryDirectory& tmp,bool library) {
+    auto source=tmp.path/"program.cpp", binary=tmp.path/(library?"program.dylib":"program");
+    write_file(source,native_source(p,library));
+    std::vector<std::string> args{"clang++","-std=c++23","-O3","-fno-fast-math","-ffp-contract=off","-I",include.string(),source.string(),"-o",binary.string()};
+    if(library) args.push_back("-dynamiclib");
+    if(process(args)!=0)throw Error("E_COMPILER: native compilation failed");return binary;
+}
+inline int jit(const Program& p,const std::filesystem::path& include) {
+    TemporaryDirectory tmp;auto binary=compile(p,include,tmp,true);
+    void* handle=dlopen(binary.c_str(),RTLD_NOW|RTLD_LOCAL);
+    if(!handle)throw Error("E_JIT: "+std::string(dlerror()));
+    struct LibraryGuard {void* h;~LibraryGuard(){dlclose(h);}} guard{handle};
+    dlerror();auto entry=reinterpret_cast<int(*)()>(dlsym(handle,"singular_entry"));
+    const char* error=dlerror();if(error||!entry)throw Error("E_JIT: entry unavailable");return entry();
+}
+inline void compile_native(const Program& p,const std::filesystem::path& include,const std::filesystem::path& out) {
+    if(std::filesystem::exists(out))throw Error("E_OUTPUT: refusing to overwrite existing artifact");
+    TemporaryDirectory tmp;auto binary=compile(p,include,tmp,false);
+    // No shell interpolation and no writes to an existing executable inode.
+    std::filesystem::copy_file(binary,out,std::filesystem::copy_options::none);
+}
+} // namespace cycraft::omega::executable
diff --git a/cycraft/include/cycraft/quantum_syntax/omega_executable_process.hpp b/cycraft/include/cycraft/quantum_syntax/omega_executable_process.hpp
new file mode 100644
index 0000000..6183621
--- /dev/null
+++ b/cycraft/include/cycraft/quantum_syntax/omega_executable_process.hpp
@@ -0,0 +1,41 @@
+#pragma once
+#include "cycraft/quantum_syntax/omega_executable_value.hpp"
+#include <cerrno>
+#include <filesystem>
+#include <fstream>
+#include <spawn.h>
+#include <sys/wait.h>
+#include <unistd.h>
+extern char **environ;
+namespace cycraft::omega::executable {
+inline int process(const std::vector<std::string>& args) {
+    if(args.empty())throw Error("E_PROCESS: missing executable");
+    std::vector<char*> argv;for(const auto& s:args)argv.push_back(const_cast<char*>(s.c_str()));argv.push_back(nullptr);
+    pid_t pid;int e=posix_spawnp(&pid,argv[0],nullptr,nullptr,argv.data(),environ);
+    if(e)throw Error("E_PROCESS: spawn error "+std::to_string(e));
+    int status=0;while(waitpid(pid,&status,0)<0)if(errno!=EINTR)throw Error("E_PROCESS: waitpid");
+    return WIFEXITED(status)?WEXITSTATUS(status):128+(WIFSIGNALED(status)?WTERMSIG(status):0);
+}
+struct TemporaryDirectory {
+    std::filesystem::path path;
+    TemporaryDirectory() {
+        std::string pattern=(std::filesystem::temp_directory_path()/"singular-native-XXXXXX").string();
+        std::vector<char> buf(pattern.begin(),pattern.end());buf.push_back(0);
+        if(!mkdtemp(buf.data()))throw Error("E_IO: temporary directory");path=buf.data();
+    }
+    ~TemporaryDirectory(){std::error_code ec;std::filesystem::remove_all(path,ec);}
+    TemporaryDirectory(const TemporaryDirectory&)=delete;
+    TemporaryDirectory& operator=(const TemporaryDirectory&)=delete;
+};
+inline std::string read_source(const std::filesystem::path& path) {
+    std::ifstream in(path,std::ios::binary);if(!in)throw Error("E_IO: cannot open "+path.string());
+    std::string data;char buffer[4096];
+    while(in.read(buffer,sizeof(buffer))||in.gcount()){
+        if(data.size()+static_cast<size_t>(in.gcount())>1<<20)throw Error("E_BUDGET: source exceeds 1 MiB");data.append(buffer,static_cast<size_t>(in.gcount()));
+    }
+    if(!in.eof())throw Error("E_IO: read failed");return data;
+}
+inline void write_file(const std::filesystem::path& path,const std::string& content) {
+    std::ofstream out(path,std::ios::binary);out<<content;out.close();if(!out)throw Error("E_IO: write failed "+path.string());
+}
+} // namespace cycraft::omega::executable
diff --git a/cycraft/include/cycraft/quantum_syntax/omega_executable_value.hpp b/cycraft/include/cycraft/quantum_syntax/omega_executable_value.hpp
new file mode 100644
index 0000000..fe2055c
--- /dev/null
+++ b/cycraft/include/cycraft/quantum_syntax/omega_executable_value.hpp
@@ -0,0 +1,106 @@
+#pragma once
+#include <algorithm>
+#include <bit>
+#include <cmath>
+#include <cstdint>
+#include <iomanip>
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <vector>
+namespace cycraft::omega::executable {
+inline constexpr size_t max_elements = 1 << 20, max_nodes = 4096, max_bytes = 64 << 20;
+struct Error : std::runtime_error { using std::runtime_error::runtime_error; };
+using Shape = std::vector<size_t>;
+inline size_t elements(const Shape& s) {
+    if (s.empty() || s.size() > 2) throw Error("E_SHAPE: rank must be 1 or 2");
+    size_t n=1;
+    for (auto d:s) { if (!d || d>max_elements/n) throw Error("E_BUDGET: tensor size"); n*=d; }
+    return n;
+}
+struct Value { Shape shape{1}; std::vector<double> data; };
+enum class Op { literal, add, sub, mul, div, matmul, kron, neg, relu, tanh, sigmoid, sum };
+inline Shape shape_of(Op op, const Shape& a, const Shape& b={1}) {
+    elements(a); elements(b);
+    if (op==Op::sum) return {1};
+    if (op==Op::matmul) {
+        if (a.size()!=2 || (b.size()!=1 && b.size()!=2) || a[1]!=b[0]) throw Error("E_SHAPE: contraction");
+        Shape s=b.size()==1 ? Shape{a[0]} : Shape{a[0],b[1]}; elements(s); return s;
+    }
+    if (op==Op::kron) {
+        if (a.size()!=b.size()) throw Error("E_SHAPE: Kronecker rank");
+        Shape s=a;
+        for (size_t i=0;i<s.size();++i) { if (b[i]>max_elements/s[i]) throw Error("E_BUDGET: Kronecker size"); s[i]*=b[i]; }
+        elements(s); return s;
+    }
+    if (op==Op::add || op==Op::sub || op==Op::mul || op==Op::div) {
+        if(a==Shape{1}) return b;
+        if(b==Shape{1} || a==b) return a;
+        throw Error("E_SHAPE: elementwise operands (only scalar broadcasting is supported)");
+    }
+    return a;
+}
+inline void validate(const Value& v) {
+    if(v.data.size()!=elements(v.shape)) throw Error("E_SHAPE: data length");
+    for(double x:v.data) if(!std::isfinite(x)) throw Error("E_NUMERIC: non-finite value");
+}
+inline Value apply(Op op, const Value& a, const Value& b=Value{{1},{0}}) {
+    validate(a); validate(b);
+    Value out{shape_of(op,a.shape,b.shape),{}}; out.data.resize(elements(out.shape));
+    if(op==Op::matmul) {
+        size_t m=a.shape[0], k=a.shape[1], n=b.shape.size()==2?b.shape[1]:1;
+        if(m>100000000/k/n) throw Error("E_BUDGET: contraction work");
+        for(size_t i=0;i<m;++i) for(size_t j=0;j<n;++j) {
+            double s=0;
+            for(size_t q=0;q<k;++q) s=s+a.data[i*k+q]*b.data[q*n+j];
+            out.data[i*n+j]=s;
+        }
+    } else if(op==Op::kron) {
+        size_t ar=a.shape.size()==2?a.shape[0]:1, ac=a.data.size()/ar;
+        size_t br=b.shape.size()==2?b.shape[0]:1, bc=b.data.size()/br;
+        for(size_t i=0;i<ar;++i) for(size_t j=0;j<ac;++j)
+            for(size_t k=0;k<br;++k) for(size_t l=0;l<bc;++l)
+                out.data[(i*br+k)*(ac*bc)+j*bc+l]=a.data[i*ac+j]*b.data[k*bc+l];
+    } else if(op==Op::sum) {
+        double s=0; for(double x:a.data) s=s+x; out.data[0]=s;
+    } else for(size_t i=0;i<out.data.size();++i) {
+        double x=a.data[a.data.size()==1?0:i], y=b.data[b.data.size()==1?0:i];
+        switch(op) {
+            case Op::add: out.data[i]=x+y; break; case Op::sub: out.data[i]=x-y; break;
+            case Op::mul: out.data[i]=x*y; break;
+            case Op::div: if(y==0) throw Error("E_NUMERIC: division by zero"); out.data[i]=x/y; break;
+            case Op::neg: out.data[i]=-x; break;
+            case Op::relu: out.data[i]=std::max(0.0,x); break;
+            case Op::tanh: out.data[i]=std::tanh(x); break;
+            case Op::sigmoid: out.data[i]=x>=0 ? 1/(1+std::exp(-x)) : std::exp(x)/(1+std::exp(x)); break;
+            default: throw Error("E_OPCODE: unsupported operation");
+        }
+    }
+    validate(out); return out;
+}
+inline bool identical(const Value& a,const Value& b) {
+    if(a.shape!=b.shape || a.data.size()!=b.data.size()) return false;
+    for(size_t i=0;i<a.data.size();++i) if(std::bit_cast<uint64_t>(a.data[i])!=std::bit_cast<uint64_t>(b.data[i])) return false;
+    return true;
+}
+inline bool equal(const Value& a,const Value& b) { return a.shape==b.shape && a.data==b.data; }
+inline void assertion(const Value& a,const Value& b,size_t line) {
+    if(!equal(a,b)) throw Error("E_ASSERT: equality failed at line "+std::to_string(line));
+}
+inline std::string quote(const std::string& s) {
+    std::string out="\"";
+    for(unsigned char c:s) {
+        if(c=='"' || c=='\\') {out+='\\';out+=char(c);}
+        else if(c<32) throw Error("E_TEXT: control character"); else out+=char(c);
+    }
+    return out+'"';
+}
+inline void print_value(std::ostream& o,const std::string& name,const Value& v) {
+    o<<"{\"symbol\":"<<quote(name)<<",\"shape\":[";
+    for(size_t i=0;i<v.shape.size();++i) o<<(i?",":"")<<v.shape[i];
+    o<<"],\"values\":["<<std::setprecision(17);
+    for(size_t i=0;i<v.data.size();++i) o<<(i?",":"")<<v.data[i];
+    o<<"]}\n";
+}
