+use std::time::Instant;
+use std::hint::black_box;
+const B:usize=32; const W:usize=128; const STEPS:usize=1000;
+fn transform(input:&[f64;W],output:&mut [f64;W]) {for j in 0..W{output[j]=(input[j]*0.5+1.0).max(0.0);}}
+fn event(step:usize)->[f64;W] {let mut a=[0.0;W];for j in 0..W{a[j]=((step+j)%257) as f64/8.0-8.0;}a}
+fn main(){println!("implementation,sample,update_ns_per_event,setup_ns,checksum,correct,workload");
+ for sample in 0..19{for slot in 0..2{let mode=(slot+sample)%2;let start=Instant::now();let mut input=[[0.0;W];B];let mut out=[[0.0;W];B];
+ for b in 0..B{for j in 0..W{input[b][j]=j as f64/8.0-8.0;}transform(&input[b],&mut out[b]);}
+ let setup=start.elapsed().as_nanos();let start=Instant::now();
+ for step in 0..STEPS{let b=step%B;input[b]=event(step);if mode==0{for k in 0..B{transform(&input[k],&mut out[k]);}}else{transform(&input[b],&mut out[b]);}black_box(&out);}
+ let elapsed=start.elapsed().as_nanos() as f64 / STEPS as f64;let mut oracle=[[0.0;W];B];
+ for b in 0..B{let last=(STEPS-1)-((STEPS-1+B-b)%B);transform(&event(last),&mut oracle[b]);}
+ let correct=out==oracle;let sum:f64=out.iter().flatten().sum();println!("{},{},{},{},{:.17},{},synthetic_32x128_relu_independent_branches",if mode==0{"rust_full"}else{"rust_incremental"},sample,elapsed,setup,sum,if correct{1}else{0});assert!(correct);
+ }}
+}
diff --git a/research/executable-benchmark/benchmark.cpp b/research/executable-benchmark/benchmark.cpp
