// SINGULAR Ω v14.0 — sdb06_cyclotomic_lsh_tensor_index.qcy
§λ("modules")
§ω("singular.v14.singulardb")
§κ("CY-SDB-6")

Ω ⟦ Ψ_0 : ⛨ℝ[56, 63], W_0 : ℝ[63, 63], K_0 : ℝ[56, 63], δ_0 : Δℝ[18], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_DB(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
