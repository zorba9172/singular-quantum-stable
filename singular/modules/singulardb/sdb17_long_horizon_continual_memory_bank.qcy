// SINGULAR Ω v15.0 — sdb17_long_horizon_continual_memory_bank.qcy
§λ("modules")
§ω("singular.v15.singulardb")
§κ("CY-SDB-17")

Ω ⟦ Ψ_0 : ⛨ℝ[90, 103], W_0 : ℝ[103, 103], K_0 : ℝ[90, 103], δ_0 : Δℝ[13], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⊛_θ(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
