// SINGULAR Ω v14.0 — sdb05_hdc_hrr_holographic_vector_index.qcy
§λ("modules")
§ω("singular.v14.singulardb")
§κ("CY-SDB-5")

Ω ⟦ Ψ_0 : ⛨ℝ[54, 56], W_0 : ℝ[56, 56], K_0 : ℝ[54, 56], δ_0 : Δℝ[17], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_DB(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
