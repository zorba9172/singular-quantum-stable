// SINGULAR Ω v14.0 — sdb03_widecolumn_bitemporal_timeseries.qcy
§λ("modules")
§ω("singular.v14.singulardb")
§κ("CY-SDB-3")

Ω ⟦ Ψ_0 : ⛨ℝ[50, 42], W_0 : ℝ[42, 42], K_0 : ℝ[50, 42], δ_0 : Δℝ[15], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_DB(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
