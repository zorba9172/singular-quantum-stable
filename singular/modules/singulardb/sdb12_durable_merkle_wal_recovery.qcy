// SINGULAR Ω v14.0 — sdb12_durable_merkle_wal_recovery.qcy
§λ("modules")
§ω("singular.v14.singulardb")
§κ("CY-SDB-12")

Ω ⟦ Ψ_0 : ⛨ℝ[68, 105], W_0 : ℝ[105, 105], K_0 : ℝ[68, 105], δ_0 : Δℝ[9], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_DB(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
