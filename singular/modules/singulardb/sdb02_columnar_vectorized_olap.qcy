// SINGULAR Ω v14.0 — sdb02_columnar_vectorized_olap.qcy
§λ("modules")
§ω("singular.v14.singulardb")
§κ("CY-SDB-2")

Ω ⟦ Ψ_0 : ⛨ℝ[48, 35], W_0 : ℝ[35, 35], K_0 : ℝ[48, 35], δ_0 : Δℝ[14], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_DB(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
