§λ("modules")
§ω("singular.v14.singulardb")
§κ("CY-SDB-9")

Ω ⟦ Ψ_0 : ⛨ℝ[62, 84], W_0 : ℝ[84, 84], K_0 : ℝ[62, 84], δ_0 : Δℝ[21], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_DB(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
