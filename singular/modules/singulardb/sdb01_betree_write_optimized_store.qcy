// SINGULAR Ω v14.0 — sdb01_betree_write_optimized_store.qcy
§λ("modules")
§ω("singular.v14.singulardb")
§κ("CY-SDB-1")

Ω ⟦ Ψ_0 : ⛨ℝ[46, 124], W_0 : ℝ[124, 124], K_0 : ℝ[46, 124], δ_0 : Δℝ[13], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_DB(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
