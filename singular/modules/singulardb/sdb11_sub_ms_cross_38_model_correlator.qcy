// SINGULAR Ω v14.0 — sdb11_sub_ms_cross_38_model_correlator.qcy
§λ("modules")
§ω("singular.v14.singulardb")
§κ("CY-SDB-11")

Ω ⟦ Ψ_0 : ⛨ℝ[66, 98], W_0 : ℝ[98, 98], K_0 : ℝ[66, 98], δ_0 : Δℝ[8], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_DB(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
