// SINGULAR Ω v15.0 — sdb15_sqlite3_relational_knowledge_catalog.qcy
§λ("modules")
§ω("singular.v15.singulardb")
§κ("CY-SDB-15")

Ω ⟦ Ψ_0 : ⛨ℝ[86, 81], W_0 : ℝ[81, 81], K_0 : ℝ[86, 81], δ_0 : Δℝ[11], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_DB(Ψ_1, W_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
