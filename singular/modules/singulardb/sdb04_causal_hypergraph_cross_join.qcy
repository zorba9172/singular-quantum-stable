// SINGULAR Ω v14.0 — sdb04_causal_hypergraph_cross_join.qcy
§λ("modules")
§ω("singular.v14.singulardb")
§κ("CY-SDB-4")

Ω ⟦ Ψ_0 : ⛨ℝ[52, 49], W_0 : ℝ[49, 49], K_0 : ℝ[52, 49], δ_0 : Δℝ[16], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_DB(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
