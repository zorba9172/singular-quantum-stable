// SINGULAR Ω v14.0 — d03_topological_anyon_braiding.qcy
§λ("modules")
§ω("singular.v14.domain20")
§κ("CY-DOM20-3")

Ω ⟦ Ψ_0 : ⛨ℝ[54, 78], W_0 : ℝ[78, 78], K_0 : ℝ[54, 78], δ_0 : Δℝ[15], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← 𝒜_★(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
