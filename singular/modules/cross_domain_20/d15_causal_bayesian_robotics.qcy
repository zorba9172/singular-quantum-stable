// SINGULAR Ω v14.0 — d15_causal_bayesian_robotics.qcy
§λ("modules")
§ω("singular.v14.domain20")
§κ("CY-DOM20-15")

Ω ⟦ Ψ_0 : ⛨ℝ[20, 66], W_0 : ℝ[66, 66], K_0 : ℝ[20, 66], δ_0 : Δℝ[12], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_ACG(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
