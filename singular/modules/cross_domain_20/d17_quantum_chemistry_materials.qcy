// SINGULAR Ω v14.0 — d17_quantum_chemistry_materials.qcy
§λ("modules")
§ω("singular.v14.domain20")
§κ("CY-DOM20-17")

Ω ⟦ Ψ_0 : ⛨ℝ[24, 80], W_0 : ℝ[80, 80], K_0 : ℝ[24, 80], δ_0 : Δℝ[14], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ℰ_λ(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
