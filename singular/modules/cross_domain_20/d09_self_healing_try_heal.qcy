// SINGULAR Ω v14.0 — d09_self_healing_try_heal.qcy
§λ("modules")
§ω("singular.v14.domain20")
§κ("CY-DOM20-9")

Ω ⟦ Ψ_0 : ⛨ℝ[66, 120], W_0 : ℝ[120, 120], K_0 : ℝ[66, 120], δ_0 : Δℝ[21], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_HEAL(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
