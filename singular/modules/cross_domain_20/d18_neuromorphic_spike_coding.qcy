// SINGULAR Ω v14.0 — d18_neuromorphic_spike_coding.qcy
§λ("modules")
§ω("singular.v14.domain20")
§κ("CY-DOM20-18")

Ω ⟦ Ψ_0 : ⛨ℝ[26, 87], W_0 : ℝ[87, 87], K_0 : ℝ[26, 87], δ_0 : Δℝ[15], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟐_S(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
