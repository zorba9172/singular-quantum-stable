// SINGULAR Ω v15.0 — otz15_verifiable_benchmark_contamination_auditor.qcy
§λ("modules")
§ω("singular.v15.otzar")
§κ("CY-OTZ-15")

Ω ⟦ Ψ_0 : ⛨ℝ[128, 120], W_0 : ℝ[120, 120], K_0 : ℝ[128, 120], δ_0 : Δℝ[17], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_DB(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
