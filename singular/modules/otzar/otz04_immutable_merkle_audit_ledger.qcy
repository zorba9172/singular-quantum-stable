// SINGULAR Ω v14.0 — otz04_immutable_merkle_audit_ledger.qcy
§λ("modules")
§ω("singular.v14.otzar")
§κ("CY-OTZ-4")

Ω ⟦ Ψ_0 : ⛨ℝ[16, 41], W_0 : ℝ[41, 41], K_0 : ℝ[16, 41], δ_0 : Δℝ[11], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_OTZ(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
