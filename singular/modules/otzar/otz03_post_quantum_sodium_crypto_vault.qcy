// SINGULAR Ω v14.0 — otz03_post_quantum_sodium_crypto_vault.qcy
§λ("modules")
§ω("singular.v14.otzar")
§κ("CY-OTZ-3")

Ω ⟦ Ψ_0 : ⛨ℝ[72, 34], W_0 : ℝ[34, 34], K_0 : ℝ[72, 34], δ_0 : Δℝ[10], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_OTZ(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
