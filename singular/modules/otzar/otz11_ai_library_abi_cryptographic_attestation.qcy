// SINGULAR Ω v15.0 — otz11_ai_library_abi_cryptographic_attestation.qcy
§λ("modules")
§ω("singular.v15.otzar")
§κ("CY-OTZ-11")

Ω ⟦ Ψ_0 : ⛨ℝ[120, 76], W_0 : ℝ[76, 76], K_0 : ℝ[120, 76], δ_0 : Δℝ[13], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_OTZ(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
