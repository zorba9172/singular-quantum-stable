// SINGULAR Ω v14.0 — arch05_cross_domain_optimization_transfer.qcy
§λ("modules")
§ω("singular.v14.archetypes")
§κ("CY-ARCH5-5")

Ω ⟦ Ψ_0 : ⛨ℝ[60, 110], W_0 : ℝ[110, 110], K_0 : ℝ[60, 110], δ_0 : Δℝ[17], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⊕_trop(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
