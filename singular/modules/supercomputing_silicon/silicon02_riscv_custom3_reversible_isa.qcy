// §λ("modules") §ω("18.0") §κ("⛨-PAT-18")
// PAT-18: RISC-V custom-3 (0x7B) 6-Op Ω-ISA & Reversible TwoSum/Cyclotomic ALU (⟁_ISA)
§λ("modules")
§ω("18.0")
§κ("⛨-172")

Ω ⟦ Ψ_0 : ⛨ℝ[162, 64], W_0 : ℝ[64, 64], δ_0 : Δℝ[16], Z_0 : ℤ[16] ⟧ {
  Ψ_1 ← ⟁_ISA(Ψ_0, δ_0)
  Ψ_2 ← ⊛_θ(Ψ_1, Z_0)
  Ψ_3 ← φτ(Ψ_0 ⋅ W_0)
  Ψ_4 ← Ψ_3 ⊕ δ_0
  Ψ_0 ← Ψ_4 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_4)
  ⊢ |Ψ_2| < ∞
}
