// §λ("modules") §ω("18.0") §κ("⛨-PAT-17")
// PAT-17: SystemVerilog-2017 Causal Compute Unit (Ω-CCU) & Priority Wavefront Engine (⟁_RTL)
§λ("modules")
§ω("18.0")
§κ("⛨-171")

Ω ⟦ Ψ_0 : ⛨ℝ[161, 64], W_0 : ℝ[64, 64], δ_0 : Δℝ[16], S_0 : ⛨ℝ[161, 64] ⟧ {
  Ψ_1 ← ⟁_RTL(Ψ_0, δ_0)
  Ψ_2 ← ⟁_CIE(Ψ_1, δ_0)
  Ψ_3 ← φ₊(Ψ_0 ⋅ W_0)
  Ψ_4 ← ⛨(Ψ_3, S_0)
  Ψ_5 ← Ψ_4 ⊕ δ_0
  Ψ_0 ← Ψ_5 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_5)
  ⊢ |Ψ_1| < ∞
}
