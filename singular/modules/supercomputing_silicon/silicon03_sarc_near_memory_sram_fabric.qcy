// PAT-19: SARC Certificate-Governed Near-Memory SRAM Compute Fabric (⟁_NMC)
§λ("modules")
§ω("18.0")
§κ("⛨-173")

Ω ⟦ Ψ_0 : ⛨ℝ[163, 64], W_0 : ℝ[64, 64], δ_0 : Δℝ[16], E_0 : ℤ[8] ⟧ {
  Ψ_1 ← ⟁_NMC(Ψ_0, δ_0)
  Ψ_2 ← ⟁_SARC(Ψ_1, δ_0)
  Ψ_3 ← ⟁_EDGE(Ψ_2, E_0)
  Ψ_4 ← Ψ_3 ⊕ δ_0
  Ψ_0 ← Ψ_4 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_4)
