§ω("singular.v35.topo.0")
§κ("V35-MOD-01")

Ω ⟦ Ψ_0 : ⛨ℝ[184, 240], W_0 : ℝ[240, 240], K_0 : ℝ[184, 240], δ_0 : Δℝ[92], ξ_0 : ⚿[32] ⟧ {
