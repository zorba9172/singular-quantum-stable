§ω("singular.v42.mod.3")
§κ("V42-MOD-04")

Ω ⟦ Ψ_0 : ⛨ℝ[526, 578], W_0 : ℝ[578, 578], K_0 : ℝ[526, 578], δ_0 : Δℝ[263], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ◈_H(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
