// SINGULAR Ω v15.0 — lms04_sparse_moe_upcycling_1200b_supermodel.qcy
§λ("modules")
§ω("singular.v15.lms")
§κ("CY-LMS-4")

Ω ⟦ Ψ_0 : ⛨ℝ[30, 123], W_0 : ℝ[123, 123], K_0 : ℝ[30, 123], δ_0 : Δℝ[11], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ⟁_MOE(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
