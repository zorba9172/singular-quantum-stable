// SINGULAR Ω v15.0 — lms08_multi_modal_scientific_world_model.qcy
§λ("modules")
§ω("singular.v15.lms")
§κ("CY-LMS-8")

Ω ⟦ Ψ_0 : ⛨ℝ[38, 71], W_0 : ℝ[71, 71], K_0 : ℝ[38, 71], δ_0 : Δℝ[15], ξ_0 : ⚿[32] ⟧ {
  Ψ_1 ← φg(Ψ_0 ⋅ W_0)
  Ψ_2 ← ↦(Ψ_1, K_0)
  Ψ_3 ← Ψ_2 ⊕ δ_0
  Ψ_0 ← Ψ_3 ↶ δ_0
  ⊢ ⇄(Ψ_0, Ψ_3)
  ⊢ |Ψ_2| < ∞
}
