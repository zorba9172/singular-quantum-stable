// ============================================================================
§λ("domain")
§ω("singular.quantum.nanotech_swarm")
§κ("SG-Q05-NANOTECH-SWARM")

Ω ⟦
  Ψ_α : ℝ[64],
  Ψ_κ : ℝ[64],
  δ_0 : Δℝ[16],
  S_0 : ⛨ℝ[64]
⟧ {
  Ψ_μ ← Ψ_α ↦ Ψ_κ
  Ψ_1 ← Ψ_μ ⊕ δ_0
  Ψ_2 ← ⛨(Ψ_1, S_0)
  Ψ_0 ← Ψ_1 ↶ δ_0
  ⊢ ⇄(Ψ_μ, Ψ_0)
  ⊢ |Ψ_2| < ∞
}
