// ============================================================================
// SINGULAR Ω v11.0 — Program Q1: Fused Symbolic Tensor Contraction (`φ₊(x ⋅ W + b)`)
// ============================================================================
§λ("domain")
§ω("singular.quantum.tensor_algebra")
§κ("SG-Q01-FUSED-TENSOR")

Ω ⟦
  x_0 : ℝ[16, 64],
  W_0 : ℝ[64, 128],
  b_0 : ℝ[16, 128],
  W_1 : ℝ[128, 128],
  b_1 : ℝ[16, 128]
⟧ {
  y_0 ← φ₊(x_0 ⋅ W_0 + b_0)
  y_1 ← (φ₊ ∘ φg)(y_0 ⋅ W_1 + b_1)
  y_2 ← φσ(y_0) ∥ φτ(y_1)
  g_0 ← ∇(y_2)
  ⊢ |y_1| < ∞
  ⊢ y_2 ≈ φ₊(y_0)
}
