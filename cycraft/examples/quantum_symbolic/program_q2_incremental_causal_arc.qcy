// ============================================================================
// SINGULAR Ω v11.0 — Program Q2: Incremental Causal Arc (`⊕`, `Δ`, `↶`, 0-Byte Log)
// ============================================================================
§λ("domain")
§ω("singular.quantum.causal_arc")
§κ("SG-Q02-CAUSAL-ARC")

Ω ⟦
  S_0 : ℝ[4096],
  δ_0 : Δℝ[32],
  W_0 : ℝ[64, 64],
  X_0 : ℝ[16, 64]
⟧ {
  S_1 ← S_0 ⊕ δ_0
  δ_1 ← Δ(S_0, δ_0)
  Y_1 ← φ₊(X_0 ⋅ W_0)
  S_2 ← S_1 ↶ δ_0 + δ_1
  ⊢ ⇄(S_0, S_2)
  ⊢ |Y_1| < ∞
}
