// ============================================================================
§λ("api")
§ω("singular.quantum.certified_service")
§κ("SG-PROG-H-CERT-008")

Ω ⟦
  Ψ_9 : ℝ[16, 64],
  W_9 : ℝ[64, 64],
  b_9 : ℝ[16, 64],
  δ_9 : Δℝ[16],
  S_9 : ⛨ℝ[16, 64]
⟧ {
  Φ_9 ← φ₊(Ψ_9 ⋅ W_9 + b_9)
  Θ_9 ← Φ_9 ⊕ δ_9
  Υ_9 ← ⛨(Θ_9, S_9)
  Ξ_9 ← Θ_9 ↶ δ_9 + Υ_9
  ⊢ ⇄(Φ_9, Ξ_9)
  ⊢ |Υ_9| < ∞
}
