// ============================================================================
// SINGULAR Ω v11.0 — Pure Quantum-Symbolic Module (`program_g_differentiable_causal_arc.qcy`)
// ============================================================================
§λ("domain")
§ω("singular.quantum.diff_arc")
§κ("SG-PROG-G-DIFF-007")

Ω ⟦
  Ψ_8 : ℝ[16, 64],
  W_8 : ℝ[64, 64],
  b_8 : ℝ[16, 64],
  δ_8 : Δℝ[16],
  S_8 : ⛨ℝ[16, 64]
⟧ {
  Φ_8 ← φ₊(Ψ_8 ⋅ W_8 + b_8)
  Θ_8 ← Φ_8 ⊕ δ_8
  Υ_8 ← ⛨(Θ_8, S_8)
  Ξ_8 ← Θ_8 ↶ δ_8 + Υ_8
  ⊢ ⇄(Φ_8, Ξ_8)
  ⊢ |Υ_8| < ∞
}
