// ============================================================================
§λ("domain")
§ω("singular.quantum.effect_handler")
§κ("SG-PROG-F-EFF-006")

Ω ⟦
  Ψ_7 : ℝ[16, 64],
  W_7 : ℝ[64, 64],
  b_7 : ℝ[16, 64],
  δ_7 : Δℝ[16],
  S_7 : ⛨ℝ[16, 64]
⟧ {
  Φ_7 ← φ₊(Ψ_7 ⋅ W_7 + b_7)
  Θ_7 ← Φ_7 ⊕ δ_7
  Υ_7 ← ⛨(Θ_7, S_7)
  Ξ_7 ← Θ_7 ↶ δ_7 + Υ_7
  ⊢ ⇄(Φ_7, Ξ_7)
  ⊢ |Υ_7| < ∞
}
