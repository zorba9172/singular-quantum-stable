// ============================================================================
// SINGULAR Ω v11.0 — Pure Quantum-Symbolic Module (`program_e_dependent_verified_arc.qcy`)
// ============================================================================
§λ("domain")
§ω("singular.quantum.dependent_arc")
§κ("SG-PROG-E-DEP-005")

Ω ⟦
  Ψ_6 : ℝ[16, 64],
  W_6 : ℝ[64, 64],
  b_6 : ℝ[16, 64],
  δ_6 : Δℝ[16],
  S_6 : ⛨ℝ[16, 64]
⟧ {
  Φ_6 ← φ₊(Ψ_6 ⋅ W_6 + b_6)
  Θ_6 ← Φ_6 ⊕ δ_6
  Υ_6 ← ⛨(Θ_6, S_6)
  Ξ_6 ← Θ_6 ↶ δ_6 + Υ_6
  ⊢ ⇄(Φ_6, Ξ_6)
  ⊢ |Υ_6| < ∞
}
